        {
          "name": "fixi_orchestration",
          "annotations": [
            {
              "tag": "xml_attribute",
              "value": "orchestration",
              "@type": "Annotation"
            }
          ],
          "description": "The address of the Orchestra file that describes the protocol's messages and rules.",
