      "@type": "TypeDefinition"
    },
    {
      "name": "FIXXMLData",
      "definition_uri": "https://w3id.org/lmodel/fix-orchestra/FIXXMLData",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "string",
          "@type": "Annotation"
        }
      ],
      "description": "FIX XMLData datatype (extends String). Contains an XML document raw data with no format or content restrictions. XMLData fields are always immediately preceded by a length field. The length field should specify the number of bytes of the value of the data field (up to but not including the terminating SOH).",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fix-orchestra",
      "exact_mappings": [
        "fixr:XMLData"
      ],
      "typeof": "string",
      "base": "str",
      "uri": "https://w3id.org/lmodel/fix-orchestra/FIXXMLData",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXLanguage",
      "definition_uri": "https://w3id.org/lmodel/fix-orchestra/FIXLanguage",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "string",
          "@type": "Annotation"
        }
      ],
      "description": "FIX Language datatype (extends String). Identifier for a national language - uses ISO 639-1 standard",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fix-orchestra",
      "exact_mappings": [
        "fixr:Language"
      ],
      "typeof": "string",
      "base": "str",
      "uri": "https://w3id.org/lmodel/fix-orchestra/FIXLanguage",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXLocalMktTime",
      "definition_uri": "https://w3id.org/lmodel/fix-orchestra/FIXLocalMktTime",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "TimeOnly",
          "@type": "Annotation"
        }
      ],
      "description": "FIX LocalMktTime datatype (extends String). string field representing the time local to a particular market center. Used where offset to UTC varies throughout the year and the defining market center is identified in a corresponding field.",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fix-orchestra",
      "exact_mappings": [
        "fixr:LocalMktTime"
      ],
      "typeof": "string",
      "base": "str",
      "uri": "https://w3id.org/lmodel/fix-orchestra/FIXLocalMktTime",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXXID",
      "definition_uri": "https://w3id.org/lmodel/fix-orchestra/FIXXID",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "string",
          "@type": "Annotation"
        }
      ],
      "description": "FIX XID datatype (extends String). The purpose of the XID datatype is to define a unique identifier that is global to a FIX message. An identifier defined using this datatype uniquely identifies its containing element, whatever its type and name is. The constraint added by this datatype is that the values of all the fields that have an XID datatype in a FIX message must be unique.",
      "in_subset": [
        "fix_base_types"
      ],
