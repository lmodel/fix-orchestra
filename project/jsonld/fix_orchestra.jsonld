      "base": "XSDDate",
      "uri": "https://w3id.org/lmodel/fix-orchestra/FIXLocalMktDate",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXTZTimeOnly",
      "definition_uri": "https://w3id.org/lmodel/fix-orchestra/FIXTZTimeOnly",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "TimeOnly",
          "@type": "Annotation"
        }
      ],
      "description": "FIX TZTimeOnly datatype (extends String). string field representing the time represented based on ISO 8601. This is the time with a UTC offset to allow identification of local time and timezone of that time.",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fix-orchestra",
      "exact_mappings": [
        "fixr:TZTimeOnly"
      ],
      "typeof": "string",
      "base": "str",
      "uri": "https://w3id.org/lmodel/fix-orchestra/FIXTZTimeOnly",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXTZTimestamp",
      "definition_uri": "https://w3id.org/lmodel/fix-orchestra/FIXTZTimestamp",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "Timestamp",
          "@type": "Annotation"
        }
      ],
      "description": "FIX TZTimestamp datatype (extends String). string field representing a time/date combination representing local time with an offset to UTC to allow identification of local time and timezone offset of that time. The representation is based on ISO 8601.",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fix-orchestra",
      "exact_mappings": [
        "fixr:TZTimestamp"
      ],
      "typeof": "datetime",
      "base": "XSDDateTime",
      "uri": "https://w3id.org/lmodel/fix-orchestra/FIXTZTimestamp",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXData",
      "definition_uri": "https://w3id.org/lmodel/fix-orchestra/FIXData",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "bytes",
          "@type": "Annotation"
        }
      ],
      "description": "FIX data base datatype. string field containing opaque or non-ASCII data with no format or content restrictions. Data fields are always immediately preceded by a length field. The length field should specify the number of bytes of the value of the data field (up to but not including the terminating SOH). The number of bytes does not equal the number of characters when multibyte character sets are used. Caution: The value of these fields may contain the delimiter (SOH) character. Note that the value specified for these fields must be followed by the delimiter (SOH) character as all tag-value fields are terminated with an SOH.",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fix-orchestra",
      "exact_mappings": [
        "fixr:data"
      ],
      "typeof": "string",
      "base": "str",
      "uri": "https://w3id.org/lmodel/fix-orchestra/FIXData",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXPattern",
      "definition_uri": "https://w3id.org/lmodel/fix-orchestra/FIXPattern",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "string",
          "@type": "Annotation"
        }
      ],
      "description": "FIX Pattern base datatype. Used to build on and provide some restrictions on what is allowed as valid values in fields that uses a base FIX data type and a pattern data type. The universe of allowable valid values for the field would then be the union of the base set of valid values and what is defined by the pattern data type. The pattern data type used by the field will retain its base FIX data type (e.g. String, int, char).",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fix-orchestra",
      "exact_mappings": [
        "fixr:Pattern"
      ],
      "typeof": "string",
      "base": "str",
      "uri": "https://w3id.org/lmodel/fix-orchestra/FIXPattern",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXTenor",
      "definition_uri": "https://w3id.org/lmodel/fix-orchestra/FIXTenor",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "Tenor",
          "@type": "Annotation"
        }
      ],
      "description": "FIX Tenor datatype (extends Pattern). used to allow the expression of FX standard tenors in addition to the base valid enumerations defined for the field that uses this pattern data type. This pattern data type is defined as follows:",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fix-orchestra",
      "exact_mappings": [
        "fixr:Tenor"
      ],
      "typeof": "string",
      "base": "str",
      "uri": "https://w3id.org/lmodel/fix-orchestra/FIXTenor",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXReserved100Plus",
      "definition_uri": "https://w3id.org/lmodel/fix-orchestra/FIXReserved100Plus",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "fixed32",
          "@type": "Annotation"
        }
      ],
      "description": "FIX Reserved100Plus datatype (extends Pattern). Values \"100\" and above are reserved for bilaterally agreed upon user defined enumerations.",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fix-orchestra",
      "exact_mappings": [
        "fixr:Reserved100Plus"
      ],
      "typeof": "integer",
      "base": "int",
      "uri": "https://w3id.org/lmodel/fix-orchestra/FIXReserved100Plus",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXReserved1000Plus",
      "definition_uri": "https://w3id.org/lmodel/fix-orchestra/FIXReserved1000Plus",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "fixed32",
          "@type": "Annotation"
        }
      ],
      "description": "FIX Reserved1000Plus datatype (extends Pattern). Values \"1000\" and above are reserved for bilaterally agreed upon user defined enumerations.",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fix-orchestra",
      "exact_mappings": [
        "fixr:Reserved1000Plus"
      ],
      "typeof": "integer",
      "base": "int",
      "uri": "https://w3id.org/lmodel/fix-orchestra/FIXReserved1000Plus",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXReserved4000Plus",
      "definition_uri": "https://w3id.org/lmodel/fix-orchestra/FIXReserved4000Plus",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "fixed32",
