          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "fixi_name",
          "annotations": [
            {
              "tag": "xml_attribute",
              "value": "name",
              "@type": "Annotation"
            }
          ],
          "description": "The protocol's name, such as FIXT or SBE, or another name of the provider's choice.",
          "any_of": [
            {
              "range": "OrchestraProtocolName",
              "@type": "AnonymousSlotExpression"
            },
            {
              "range": "string",
              "@type": "AnonymousSlotExpression"
            }
          ],
          "@type": "SlotDefinition"
        },
        {
          "name": "fixi_version",
          "annotations": [
            {
              "tag": "xml_attribute",
              "value": "version",
