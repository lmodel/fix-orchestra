          "annotations": [
            {
              "tag": "xml_attribute",
              "value": "contentType",
              "@type": "Annotation"
            }
          ],
          "description": "The media type of the text; text/plain when none is given.",
          "ifabsent": "string(text/plain)",
          "range": "string",
          "pattern": "^[\\s\\S]{3,}$",
          "@type": "SlotDefinition"
        }
