          "annotations": [
            {
              "tag": "xml_any",
              "value": "attributes",
              "@type": "Annotation"
            }
          ],
          "description": "Attributes from other namespaces, kept as written.",
          "range": "OrchestraXmlAttribute",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
