      "base": "str",
      "uri": "https://w3id.org/lmodel/fix-orchestra/TransportUse",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXInt",
      "definition_uri": "https://w3id.org/lmodel/fix-orchestra/FIXInt",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "fixed32",
          "@type": "Annotation"
        }
      ],
      "description": "FIX int base datatype. Sequence of digits without commas or decimals and optional sign character (ASCII characters \"-\" and \"0\" - \"9\" ). The sign character utilizes one byte (i.e. positive int is \"99999\" while negative int is \"-99999\"). Note that int values may contain leading zeros (e.g. \"00023\" = \"23\").",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fix-orchestra",
      "exact_mappings": [
        "fixr:int"
      ],
      "typeof": "integer",
      "base": "int",
      "uri": "https://w3id.org/lmodel/fix-orchestra/FIXInt",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXLength",
      "definition_uri": "https://w3id.org/lmodel/fix-orchestra/FIXLength",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "fixed32",
          "@type": "Annotation"
        }
      ],
      "description": "FIX Length datatype (extends int). int field representing the length in bytes. Value must be positive.",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fix-orchestra",
      "exact_mappings": [
        "fixr:Length"
      ],
      "typeof": "integer",
      "base": "int",
      "uri": "https://w3id.org/lmodel/fix-orchestra/FIXLength",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXTagNum",
      "definition_uri": "https://w3id.org/lmodel/fix-orchestra/FIXTagNum",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "fixed32",
          "@type": "Annotation"
        }
      ],
      "description": "FIX TagNum datatype (extends int). int field representing a field's tag number when using FIX \"Tag=Value\" syntax. Value must be positive and may not contain leading zeros.",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fix-orchestra",
      "exact_mappings": [
        "fixr:TagNum"
      ],
      "typeof": "integer",
      "base": "int",
      "uri": "https://w3id.org/lmodel/fix-orchestra/FIXTagNum",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXSeqNum",
      "definition_uri": "https://w3id.org/lmodel/fix-orchestra/FIXSeqNum",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "fixed32",
          "@type": "Annotation"
        }
      ],
      "description": "FIX SeqNum datatype (extends int). int field representing a message sequence number. Value must be positive.",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fix-orchestra",
      "exact_mappings": [
        "fixr:SeqNum"
      ],
      "typeof": "integer",
      "base": "int",
      "uri": "https://w3id.org/lmodel/fix-orchestra/FIXSeqNum",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXNumInGroup",
      "definition_uri": "https://w3id.org/lmodel/fix-orchestra/FIXNumInGroup",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "fixed32",
          "@type": "Annotation"
        }
      ],
      "description": "FIX NumInGroup datatype (extends int). int field representing the number of entries in a repeating group. Value must be positive.",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fix-orchestra",
      "exact_mappings": [
        "fixr:NumInGroup"
      ],
      "typeof": "string",
      "base": "str",
      "uri": "https://w3id.org/lmodel/fix-orchestra/FIXNumInGroup",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXDayOfMonth",
      "definition_uri": "https://w3id.org/lmodel/fix-orchestra/FIXDayOfMonth",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "fixed32",
          "@type": "Annotation"
        }
      ],
      "description": "FIX DayOfMonth datatype (extends int). int field representing a day during a particular month (values 1 to 31).",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fix-orchestra",
      "exact_mappings": [
        "fixr:DayOfMonth"
      ],
      "typeof": "integer",
      "base": "int",
      "uri": "https://w3id.org/lmodel/fix-orchestra/FIXDayOfMonth",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXFloat",
      "definition_uri": "https://w3id.org/lmodel/fix-orchestra/FIXFloat",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "double",
          "@type": "Annotation"
        }
      ],
      "description": "FIX float base datatype. Sequence of digits with optional decimal point and sign character (ASCII characters \"-\", \"0\" - \"9\" and \".\"); the absence of the decimal point within the string will be interpreted as the float representation of an integer value. All float fields must accommodate up to fifteen significant digits. The number of decimal places used should be a factor of business/market needs and mutual agreement between counterparties. Note that float values may contain leading zeros (e.g. \"00023.23\" = \"23.23\") and may contain or omit trailing zeros after the decimal point (e.g. \"23.0\" = \"23.0000\" = \"23\" = \"23.\"). Note that fields which are derived from float may contain negative values unless explicitly specified otherwise.",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fix-orchestra",
      "exact_mappings": [
        "fixr:float"
      ],
      "typeof": "float",
      "base": "float",
      "uri": "https://w3id.org/lmodel/fix-orchestra/FIXFloat",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXQty",
      "definition_uri": "https://w3id.org/lmodel/fix-orchestra/FIXQty",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "Decimal64",
          "@type": "Annotation"
        }
      ],
      "description": "FIX Qty datatype (extends float). float field capable of storing either a whole number (no decimal places) of \"shares\" (securities denominated in whole units) or a decimal value containing decimal places for non-share quantity asset classes (securities denominated in fractional units).",
      "in_subset": [
        "fix_base_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fix-orchestra",
      "exact_mappings": [
        "fixr:Qty"
      ],
      "typeof": "float",
      "base": "float",
      "uri": "https://w3id.org/lmodel/fix-orchestra/FIXQty",
      "@type": "TypeDefinition"
    },
    {
      "name": "FIXPrice",
      "definition_uri": "https://w3id.org/lmodel/fix-orchestra/FIXPrice",
      "annotations": [
        {
          "tag": "proto_scalar",
          "value": "Decimal64",
          "@type": "Annotation"
        }
      ],
      "description": "FIX Price datatype (extends float). float field representing a price. Note the number of decimal places may vary. For certain asset classes prices may be negative values. For example, prices for options strategies can be negative under certain market conditions. Refer to Volume 7: FIX Usage by Product for asset classes that support negative price values.",
      "in_subset": [
        "fix_base_types"
