    {
      "name": "Synchronization",
      "definition_uri": "https://w3id.org/lmodel/fix-orchestra/Synchronization",
      "in_subset": [
        "repository_types"
      ],
      "from_schema": "https://w3id.org/lmodel/fix-orchestra",
      "aliases": [
        "synchronization"
      ],
      "exact_mappings": [
        "fixr:synchronization"
      ],
      "enum_uri": "fix_orchestra:Synchronization",
      "permissible_values": [
        {
          "text": "asynchronous",
          "description": "Event timing is completely independent"
        },
        {
          "text": "synchronous",
          "description": "Requests in-progress block subsequent requests"
        },
        {
          "text": "pipelined",
          "description": "Response timing is dependent on a request, but multiple requests can be in-flight"
        }
      ]
    },
