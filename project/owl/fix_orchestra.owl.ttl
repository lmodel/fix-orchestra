<https://w3id.org/lmodel/fix-orchestra.owl.ttl> dcterms:license "Apache-2.0" ;
	dcterms:source <https://github.com/FIXTradingCommunity/fix-orchestra-spec> ;
	dcterms:title "FIX Orchestra" ;
	pav:version "1.0, 1.1-rc3" ;
	a owl:Ontology ;
	rdfs:label "fix_orchestra" ;
	rdfs:seeAlso <https://github.com/FIXTradingCommunity/fix-orchestra-spec> , <https://lmodel.github.io/fix-orchestra> ;
	skos:definition "A LinkML model of FIX Orchestra, the FIX Trading Community's standard for rules of engagement that a machine can read. It renders two editions from their XSDs, the v1.0 Technical Standard and the v1.1 third release candidate, so that an Orchestra repository or interfaces file of either edition converts to records that validate here." ;
	fix_orchestra:edition_1.0 "fix-orchestra-spec v1.0 e2b65db8505244f2708c468fe7cad60855fa9834" ;
	fix_orchestra:edition_1.1-rc3 "fix-orchestra v1.1-rc3 eb4bb9de3bd8802c6e5e0aba06182407b22acc9b" .
