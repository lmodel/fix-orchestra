            owl:onProperty fix_orchestra:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:onexit ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fix_orchestra:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:annotation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:onentry ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:activity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:onentry ] ;
