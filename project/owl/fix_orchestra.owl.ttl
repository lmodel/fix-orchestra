fix_orchestra:OidGrp a owl:Class ;
    rdfs:label "OidGrp" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:scenario_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom fixr:Name_t ;
            owl:onProperty fix_orchestra:abbr_name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fix_orchestra:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom fixr:Name_t ;
            owl:onProperty fix_orchestra:scenario ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:abbr_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:scenario_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom fixr:id_t ;
            owl:onProperty fix_orchestra:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom fixr:id_t ;
            owl:onProperty fix_orchestra:scenario_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fix_orchestra:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:abbr_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:scenario ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:scenario ],
        [ a owl:Restriction ;
            owl:allValuesFrom fixr:Name_t ;
            owl:onProperty fix_orchestra:name ] ;
    skos:altLabel "oidGrp" ;
    skos:definition "The identifiers of a message element" ;
    skos:exactMatch fixr:oidGrp ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> .

