            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:component_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_orchestra:ComponentRefType ;
            owl:onProperty fix_orchestra:component_ref ],
