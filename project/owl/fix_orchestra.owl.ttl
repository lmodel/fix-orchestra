        fix_orchestra:FieldAttribGrp,
        fix_orchestra:RefidGrp ;
    skos:altLabel "fieldRefType" ;
    skos:exactMatch fixr:fieldRefType ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> ;
    fix_orchestra:xsd_source "repositorytypes.xsd" .

fix_orchestra:category a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "category" ;
    skos:definition "A business process category, a subcategory of a businessArea" ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> .

fix_orchestra:assign a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "assign" ;
    skos:definition "Content of element holds an assignment expression for a message field or state variable",
        "Content of element holds an assignment expression for a message field or state variable. This can be used for field validation.",
        "Content of element holds an assignment expression for a state variable in the form '$actor.variable=value'",
        "Field ID assigned" ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> .

fix_orchestra:content a owl:DatatypeProperty ;
    rdfs:label "content" ;
    rdfs:range xsd:string ;
    skos:definition "Pass-through xs:any content as raw strings." ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> .

fix_orchestra:lang_id a owl:DatatypeProperty ;
    rdfs:label "lang_id" ;
    skos:altLabel "langId" ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> .

fix_orchestra:purpose a owl:DatatypeProperty ;
    rdfs:label "purpose" ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> .

fix_orchestra:rendering a owl:DatatypeProperty ;
    rdfs:label "rendering" ;
    rdfs:range xsd:string ;
    skos:definition "A hint to processes about how to interpret the element. Not validated." ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> .

fix_orchestra:spec_url a owl:DatatypeProperty ;
    rdfs:label "spec_url" ;
    rdfs:range xsd:anyURI ;
    skos:altLabel "specUrl" ;
    skos:definition "Reference documentation" ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> .

fix_orchestra:DctermsRelation a owl:Class ;
    rdfs:label "DctermsRelation" ;
    rdfs:subClassOf fix_orchestra:DcRelation ;
    skos:altLabel "relation" ;
    skos:exactMatch dcterms:relation ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> ;
    fix_orchestra:xsd_source "dcterms.xsd" .

fix_orchestra:EntityAttribGrp a owl:Class ;
    rdfs:label "EntityAttribGrp" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:replaced_by_field ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:added ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:issue ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:updated ],
        [ a owl:Restriction ;
            owl:allValuesFrom fixr:changeType_t ;
            owl:onProperty fix_orchestra:change_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:change_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom fixr:EP_t ;
            owl:onProperty fix_orchestra:added_ep ],
        [ a owl:Restriction ;
            owl:allValuesFrom fixr:Version_t ;
            owl:onProperty fix_orchestra:replaced ],
        [ a owl:Restriction ;
            owl:allValuesFrom fixr:Version_t ;
            owl:onProperty fix_orchestra:added ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:deprecated ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:replaced_ep ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:added_ep ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:replaced ],
        [ a owl:Restriction ;
            owl:allValuesFrom fixr:Version_t ;
            owl:onProperty fix_orchestra:last_modified ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:issue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:updated ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:supported ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:deprecated ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:added ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:replaced_ep ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:change_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:replaced_by_field ],
        [ a owl:Restriction ;
            owl:allValuesFrom fixr:EP_t ;
            owl:onProperty fix_orchestra:updated_ep ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:updated_ep ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:last_modified ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:supported ],
        [ a owl:Restriction ;
            owl:allValuesFrom fixr:Version_t ;
            owl:onProperty fix_orchestra:updated ],
        [ a owl:Restriction ;
            owl:allValuesFrom fixr:EP_t ;
            owl:onProperty fix_orchestra:deprecated_ep ],
        [ a owl:Restriction ;
            owl:allValuesFrom fixr:EP_t ;
            owl:onProperty fix_orchestra:replaced_ep ],
        [ a owl:Restriction ;
            owl:allValuesFrom fixr:Version_t ;
            owl:onProperty fix_orchestra:deprecated ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fix_orchestra:issue ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:deprecated_ep ],
        [ a owl:Restriction ;
            owl:allValuesFrom fixr:supportType ;
            owl:onProperty fix_orchestra:supported ],
        [ a owl:Restriction ;
            owl:allValuesFrom fixr:id_t ;
            owl:onProperty fix_orchestra:replaced_by_field ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:replaced ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:last_modified ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:added_ep ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:updated_ep ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:deprecated_ep ] ;
    skos:altLabel "entityAttribGrp" ;
    skos:exactMatch fixr:entityAttribGrp ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> .

fix_orchestra:component_ref a owl:ObjectProperty ;
    rdfs:label "component_ref" ;
    rdfs:range fix_orchestra:ComponentRefType ;
    skos:altLabel "componentRef" ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> .

fix_orchestra:group_ref a owl:ObjectProperty ;
    rdfs:label "group_ref" ;
    rdfs:range fix_orchestra:GroupRefType ;
    skos:altLabel "groupRef" ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> .

fix_orchestra:type a owl:DatatypeProperty ;
    rdfs:label "type" ;
    skos:definition "Attribute type refers to a datatype name",
        "Free-text value of the Dublin Core element/refinement `type`. Expanded from the XSD substitutionGroup chain rooted at dc:any.",
        "Overrides the type of the referenced field.",
        "Underlying FIX datatype of codes" ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> .

fix_orchestra:when a owl:DatatypeProperty ;
    rdfs:label "when" ;
    rdfs:range fixr:expressionType ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> .

fix_orchestra:field_ref a owl:ObjectProperty ;
    rdfs:label "field_ref" ;
    rdfs:range fix_orchestra:FieldRefType ;
    skos:altLabel "fieldRef" ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> .

fix_orchestra:scenario a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "scenario" ;
    skos:definition "The use case of a datatype by name",
        "The use case of an element, distinguished by workflow, asset class, etc." ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> .

fix_orchestra:scenario_id a owl:DatatypeProperty ;
    rdfs:label "scenario_id" ;
    rdfs:range fixr:id_t ;
    skos:altLabel "scenarioId" ;
    skos:definition "Unique identifier of a scenario. Default is '1' for base scenario." ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> .

fixr:id_t a rdfs:Datatype ;
    owl:equivalentClass xsd:integer .

fix_orchestra:DcSimpleLiteral a owl:Class ;
    rdfs:label "DcSimpleLiteral" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fix_orchestra:lang ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:content ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fix_orchestra:content ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:lang ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fix_orchestra:value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:lang ] ;
    skos:altLabel "SimpleLiteral" ;
    skos:definition "This is the default type for all of the DC elements. It permits text content only with optional xml:lang attribute. Text is allowed because mixed=\"true\", but sub-elements are disallowed because minOccurs=\"0\" and maxOccurs=\"0\" are on the xs:any tag. This complexType allows for restriction or extension permitting child elements." ;
    skos:exactMatch dc:SimpleLiteral ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> ;
    fix_orchestra:xsd_base "xs:anyType" ;
    fix_orchestra:xsd_source "dc.xsd" .

fix_orchestra:id a owl:DatatypeProperty ;
    rdfs:label "id" ;
    skos:definition "Numeric identifier generally must be unique within a file for an element type, e.g. unique field tag",
        "Unique numeric identifier. Default is '1' is for base scenario.",
        "id (as an attribute name) denotes an attribute whose value should be interpreted as if declared to be of type ID. This name is reserved by virtue of its definition in the xml:id specification. See http://www.w3.org/TR/xml-id/ for information about this attribute." ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> .

fix_orchestra:DcAny a owl:Class ;
    rdfs:label "DcAny" ;
    rdfs:subClassOf [ owl:unionOf ( fix_orchestra:DcContributor fix_orchestra:DcCoverage fix_orchestra:DcCreator fix_orchestra:DcDate fix_orchestra:DcDescription fix_orchestra:DcFormat fix_orchestra:DcIdentifier fix_orchestra:DcLanguage fix_orchestra:DcPublisher fix_orchestra:DcRelation fix_orchestra:DcRights fix_orchestra:DcSource fix_orchestra:DcSubject fix_orchestra:DcTitle fix_orchestra:DcType fix_orchestra:DctermsAccrualMethod fix_orchestra:DctermsAccrualPeriodicity fix_orchestra:DctermsAccrualPolicy fix_orchestra:DctermsAudience fix_orchestra:DctermsInstructionalMethod fix_orchestra:DctermsProvenance fix_orchestra:DctermsRightsHolder ) ],
        fix_orchestra:DcSimpleLiteral ;
    skos:altLabel "any" ;
    skos:exactMatch dc:any ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> ;
    fix_orchestra:xsd_source "dc.xsd" .

fix_orchestra:value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    rdfs:range xsd:string ;
    skos:definition "Mixed text content of the element." ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> .

fix_orchestra:Annotation a owl:Class ;
    rdfs:label "Annotation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom fix_orchestra:Appinfo ;
            owl:onProperty fix_orchestra:appinfo ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:appinfo ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_orchestra:Documentation ;
            owl:onProperty fix_orchestra:documentation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:documentation ],
        fix_orchestra:EntityAttribGrp ;
    skos:altLabel "annotation" ;
    skos:exactMatch fixr:annotation ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> ;
    fix_orchestra:xsd_source "repositorytypes.xsd" .

fix_orchestra:base a owl:DatatypeProperty ;
    rdfs:label "base" ;
    skos:definition "A datatype from which a subtype is created by restriction or a derived type is created by a generator",
        "base (as an attribute name) denotes an attribute whose value provides a URI to be used as the base for interpreting any relative URIs in the scope of the element on which it appears; its value is inherited. This name is reserved by virtue of its definition in the XML Base specification. See http://www.w3.org/TR/xmlbase/ for information about this attribute." ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> .

fixr:Name_t a rdfs:Datatype ;
    owl:equivalentClass xsd:string .

fix_orchestra:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    skos:definition "Name of the timer",
        "Name of the transition to invoke",
        "Name of this rule",
        "Stable name that does not change with minor version updates",
        "The name is optional as part of a reference and only for convenience. It is not enforced by referential integrity. However, the name of the referred object is authoritative. A validator may check the consistency between the name used for the reference and the name of the referred object.",
        "Unique name" ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> .

fix_orchestra:annotation a owl:ObjectProperty ;
    rdfs:label "annotation" ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> .


