    skos:inScheme fix_orchestra:dc ;
    fix_orchestra:xsd_group_members "any" ;
    fix_orchestra:xsd_source "dc.xsd" .

fix_orchestra:DctermsAbstract a owl:Class ;
    rdfs:label "DctermsAbstract" ;
    rdfs:subClassOf fix_orchestra:DctermsDescription ;
    skos:altLabel "abstract" ;
    skos:exactMatch dcterms:abstract ;
    skos:inScheme fix_orchestra:dc ;
    fix_orchestra:xsd_source "dcterms.xsd" .

fix_orchestra:DctermsAccessRights a owl:Class ;
    rdfs:label "DctermsAccessRights" ;
