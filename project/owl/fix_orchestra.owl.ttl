        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:union_data_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom fixr:id_t ;
            owl:onProperty fix_orchestra:discriminator_id ],
