        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:scenario_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_orchestra:Id ;
            owl:onProperty fix_orchestra:scenario_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:scenario ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fix_orchestra:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_orchestra:Name ;
            owl:onProperty fix_orchestra:abbr_name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fix_orchestra:id ],
