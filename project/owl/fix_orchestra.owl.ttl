    fix_orchestra:xsd_keyrefs "producerKeyRef(refer=fixr:actorKey, selector=fixr:flow, fields=[@source]); consumerKeyRef(refer=fixr:actorKey, selector=fixr:flow, fields=[@destination])" ;
