        [ a owl:Restriction ;
            owl:allValuesFrom fix_orchestra:GroupRefType ;
            owl:onProperty fix_orchestra:group_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom fixr:memberType ;
            owl:onProperty fix_orchestra:which ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:field_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom fixr:Name_t ;
            owl:onProperty fix_orchestra:category ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_orchestra:Annotation ;
            owl:onProperty fix_orchestra:annotation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:category ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:category ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:rendering ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:rendering ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:which ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:which ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_orchestra:FieldRefType ;
            owl:onProperty fix_orchestra:field_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:annotation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:annotation ],
        fix_orchestra:EntityAttribGrp,
        fix_orchestra:OidGrp,
        fix_orchestra:ScenarioRefGrp ;
    skos:altLabel "componentType" ;
