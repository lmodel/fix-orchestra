fix_orchestra:DcElementsGroup a owl:Class ;
    rdfs:label "DcElementsGroup" ;
    skos:altLabel "elementsGroup" ;
    skos:definition "This group is included as a convenience for schema authors who need to refer to all the elements in the http://purl.org/dc/elements/1.1/ namespace." ;
