            owl:onProperty fix_orchestra:annotation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:layer ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:annotation ],
        [ a owl:Restriction ;
