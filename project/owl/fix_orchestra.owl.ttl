        <https://w3id.org/lmodel/fix-orchestra/TransportUseEnum#primary>,
        <https://w3id.org/lmodel/fix-orchestra/TransportUseEnum#secondary> .

fix_orchestra:TriggerType a owl:Class ;
    rdfs:label "TriggerType" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fix_orchestra:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:actor ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fix_orchestra:state_machine ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fix_orchestra:state_machine ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:state_machine ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_orchestra:Name ;
            owl:onProperty fix_orchestra:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_orchestra:Name ;
            owl:onProperty fix_orchestra:actor ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty fix_orchestra:actor ] ;
    skos:altLabel "triggerType" ;
    skos:exactMatch fixr:triggerType,
        fix_orchestra:TriggerType ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> ;
    fix_orchestra:xsd_source "repositorytypes.xsd" .

