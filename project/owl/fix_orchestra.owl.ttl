        <https://w3id.org/lmodel/fix-orchestra/Presence#forbidden>,
        <https://w3id.org/lmodel/fix-orchestra/Presence#ignored>,
        <https://w3id.org/lmodel/fix-orchestra/Presence#optional>,
        <https://w3id.org/lmodel/fix-orchestra/Presence#required> .

fix_orchestra:group a owl:DatatypeProperty,
        owl:ObjectProperty .

fix_orchestra:impl_max_occurs a owl:DatatypeProperty ;
    rdfs:label "impl_max_occurs" ;
    rdfs:range fix_orchestra:UnboundedIntType ;
    skos:altLabel "implMaxOccurs" ;
    skos:definition "Upper bound of group instances (numInGroup)" ;
    skos:exactMatch fixr:implMaxOccurs ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> .

fix_orchestra:impl_min_occurs a owl:DatatypeProperty ;
    rdfs:label "impl_min_occurs" ;
    rdfs:range xsd:integer ;
    skos:altLabel "implMinOccurs" ;
    skos:definition "Lower bound of group instances (numInGroup)" ;
    skos:exactMatch fixr:implMinOccurs ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> .

fix_orchestra:lang a owl:DatatypeProperty .

fix_orchestra:presence a owl:ObjectProperty ;
    rdfs:label "presence" ;
    rdfs:range fix_orchestra:Presence ;
    skos:definition "Overrides presence when expression is true" ;
    skos:exactMatch fixr:presence ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> .

fix_orchestra:source a owl:DatatypeProperty ;
    rdfs:label "source" ;
    rdfs:range xsd:string ;
    skos:definition "Free-text value of the Dublin Core element/refinement `source`. Expanded from the XSD substitutionGroup chain rooted at dc:any." ;
    skos:inScheme fix_orchestra:dc .

fix_orchestra:which a owl:ObjectProperty ;
    rdfs:label "which" ;
    rdfs:range fix_orchestra:MemberType ;
    skos:definition "Member selection within each group instance" ;
    skos:exactMatch fixr:which ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> .

fix_orchestra:ComponentRefType a owl:Class ;
    rdfs:label "ComponentRefType" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:rule ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_orchestra:Presence ;
            owl:onProperty fix_orchestra:presence ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:presence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:annotation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:presence ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_orchestra:ComponentRuleType ;
            owl:onProperty fix_orchestra:rule ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_orchestra:Annotation ;
            owl:onProperty fix_orchestra:annotation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:annotation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:instance_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:block_assignment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:instance_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_orchestra:BlockAssignmentType ;
            owl:onProperty fix_orchestra:block_assignment ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_orchestra:ComponentName ;
            owl:onProperty fix_orchestra:instance_name ],
        fix_orchestra:EntityAttribGrp,
        fix_orchestra:RefidGrp ;
    skos:altLabel "componentRefType" ;
    skos:exactMatch fixr:componentRefType,
        fix_orchestra:ComponentRefType ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> ;
    fix_orchestra:xsd_source "repositorytypes.xsd" .

fix_orchestra:ExpressionType a rdfs:Datatype ;
    owl:equivalentClass xsd:string .

fix_orchestra:Version a rdfs:Datatype ;
    owl:equivalentClass xsd:string .

fix_orchestra:extra_attributes a owl:DatatypeProperty ;
    rdfs:label "extra_attributes" ;
    rdfs:range xsd:string ;
    skos:definition "Pass-through xs:anyAttribute values keyed by their XML attribute name (open extension point)." ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> .

fix_orchestra:ProtocolEnum a owl:Class ;
    rdfs:label "ProtocolEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/fix-orchestra/ProtocolEnum#FIX4> <https://w3id.org/lmodel/fix-orchestra/ProtocolEnum#FIXT> <https://w3id.org/lmodel/fix-orchestra/ProtocolEnum#FIXP> <https://w3id.org/lmodel/fix-orchestra/ProtocolEnum#tagvalue> <https://w3id.org/lmodel/fix-orchestra/ProtocolEnum#FIXML> <https://w3id.org/lmodel/fix-orchestra/ProtocolEnum#FAST> <https://w3id.org/lmodel/fix-orchestra/ProtocolEnum#SBE> <https://w3id.org/lmodel/fix-orchestra/ProtocolEnum#SOFH> <https://w3id.org/lmodel/fix-orchestra/ProtocolEnum#GPB> <https://w3id.org/lmodel/fix-orchestra/ProtocolEnum#JSON> <https://w3id.org/lmodel/fix-orchestra/ProtocolEnum#FIXS> ) ;
    skos:altLabel "protocolEnum_t" ;
    skos:definition "List of FIX protocols to standardize spelling" ;
    skos:exactMatch fixi:protocolEnum_t ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> ;
    linkml:permissible_values <https://w3id.org/lmodel/fix-orchestra/ProtocolEnum#FAST>,
        <https://w3id.org/lmodel/fix-orchestra/ProtocolEnum#FIX4>,
        <https://w3id.org/lmodel/fix-orchestra/ProtocolEnum#FIXML>,
        <https://w3id.org/lmodel/fix-orchestra/ProtocolEnum#FIXP>,
        <https://w3id.org/lmodel/fix-orchestra/ProtocolEnum#FIXS>,
        <https://w3id.org/lmodel/fix-orchestra/ProtocolEnum#FIXT>,
        <https://w3id.org/lmodel/fix-orchestra/ProtocolEnum#GPB>,
        <https://w3id.org/lmodel/fix-orchestra/ProtocolEnum#JSON>,
        <https://w3id.org/lmodel/fix-orchestra/ProtocolEnum#SBE>,
        <https://w3id.org/lmodel/fix-orchestra/ProtocolEnum#SOFH>,
        <https://w3id.org/lmodel/fix-orchestra/ProtocolEnum#tagvalue> .

fix_orchestra:category a owl:DatatypeProperty,
        owl:ObjectProperty .

fix_orchestra:FieldRefType a owl:Class ;
    rdfs:label "FieldRefType" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:length_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:annotation ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_orchestra:Annotation ;
            owl:onProperty fix_orchestra:annotation ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_orchestra:Id ;
            owl:onProperty fix_orchestra:non_encoded_field_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:length_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:rule ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_orchestra:FieldRuleType ;
            owl:onProperty fix_orchestra:rule ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:assign ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:assign ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:instance_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_orchestra:Id ;
            owl:onProperty fix_orchestra:length_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:non_encoded_field_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_orchestra:Name ;
            owl:onProperty fix_orchestra:instance_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_orchestra:ExpressionType ;
            owl:onProperty fix_orchestra:assign ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:instance_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:non_encoded_field_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:annotation ],
        fix_orchestra:EntityAttribGrp,
        fix_orchestra:FieldAttribGrp,
        fix_orchestra:RefidGrp ;
    skos:altLabel "fieldRefType" ;
    skos:closeMatch <fix_sbe:RefTypeV1>,
        <fix_sbe:RefTypeV2> ;
    skos:exactMatch fixr:fieldRefType,
        fix_orchestra:FieldRefType ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> ;
    fix_orchestra:xsd_source "repositorytypes.xsd" .

fix_orchestra:assign a owl:DatatypeProperty,
        owl:ObjectProperty .

fix_orchestra:content a owl:DatatypeProperty ;
    rdfs:label "content" ;
    rdfs:range xsd:string ;
    skos:definition "Pass-through xs:any content as raw strings." ;
    skos:inScheme fix_orchestra:dc .

fix_orchestra:lang_id a owl:DatatypeProperty .

fix_orchestra:purpose a owl:DatatypeProperty .

fix_orchestra:rendering a owl:DatatypeProperty ;
    rdfs:label "rendering" ;
    rdfs:range xsd:string ;
    skos:definition "A hint to processes about how to interpret the element. Not validated." ;
    skos:exactMatch fixr:rendering ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> .

fix_orchestra:spec_url a owl:DatatypeProperty ;
    rdfs:label "spec_url" ;
    rdfs:range xsd:anyURI ;
    skos:altLabel "specUrl" ;
    skos:definition "Reference documentation" ;
    skos:exactMatch fixr:specUrl ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> .

fix_orchestra:DctermsRelation a owl:Class ;
    rdfs:label "DctermsRelation" ;
    rdfs:subClassOf fix_orchestra:DcRelation ;
    skos:altLabel "relation" ;
    skos:exactMatch dcterms:relation ;
    skos:inScheme fix_orchestra:dc ;
    fix_orchestra:xsd_source "dcterms.xsd" .

fix_orchestra:component_ref a owl:ObjectProperty ;
    rdfs:label "component_ref" ;
    rdfs:range fix_orchestra:ComponentRefType ;
    skos:altLabel "componentRef" ;
    skos:exactMatch fixr:componentRef ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> .

fix_orchestra:group_ref a owl:ObjectProperty ;
    rdfs:label "group_ref" ;
    rdfs:range fix_orchestra:GroupRefType ;
    skos:altLabel "groupRef" ;
    skos:exactMatch fixr:groupRef ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> .

fix_orchestra:EntityAttribGrp a owl:Class ;
    rdfs:label "EntityAttribGrp" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:deprecated_ep ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:supported ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:replaced_by_field ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:updated ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:last_modified ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:replaced_ep ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:updated ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:replaced_ep ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:replaced ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:updated_ep ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:issue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:change_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_orchestra:Id ;
            owl:onProperty fix_orchestra:replaced_by_field ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fix_orchestra:issue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:last_modified ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_orchestra:EP ;
            owl:onProperty fix_orchestra:added_ep ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_orchestra:Version ;
            owl:onProperty fix_orchestra:deprecated ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:added ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_orchestra:SupportType ;
            owl:onProperty fix_orchestra:supported ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:replaced ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:deprecated_ep ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:supported ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_orchestra:Version ;
            owl:onProperty fix_orchestra:updated ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_orchestra:EP ;
            owl:onProperty fix_orchestra:deprecated_ep ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_orchestra:EP ;
            owl:onProperty fix_orchestra:replaced_ep ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_orchestra:Version ;
            owl:onProperty fix_orchestra:last_modified ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:deprecated ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_orchestra:ChangeType ;
            owl:onProperty fix_orchestra:change_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_orchestra:Version ;
            owl:onProperty fix_orchestra:added ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:added_ep ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:added_ep ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:issue ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:added ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_orchestra:EP ;
            owl:onProperty fix_orchestra:updated_ep ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:change_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_orchestra:Version ;
            owl:onProperty fix_orchestra:replaced ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:replaced_by_field ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:deprecated ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:updated_ep ] ;
    skos:altLabel "entityAttribGrp" ;
    skos:closeMatch <fix_sbe:VersionAttributes> ;
    skos:exactMatch fixr:entityAttribGrp,
        fix_orchestra:EntityAttribGrp ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> .

fix_orchestra:type a owl:DatatypeProperty .

fix_orchestra:when a owl:DatatypeProperty ;
    rdfs:label "when" ;
    rdfs:range fix_orchestra:ExpressionType ;
    skos:definition "A condition that distinguishes when a scenario of a message type applies. It could be used to generate a decision tree to correlate an incoming message to its scenario, or to decide which scenario of a request message to send." ;
    skos:exactMatch fixr:when ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> .

fix_orchestra:field_ref a owl:ObjectProperty ;
    rdfs:label "field_ref" ;
    rdfs:range fix_orchestra:FieldRefType ;
    skos:altLabel "fieldRef" ;
    skos:definition "Other field or fields that scope uniqueness. If none provided, then the field value must be globally unique." ;
    skos:exactMatch fixr:fieldRef ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> .

fix_orchestra:scenario a owl:DatatypeProperty,
        owl:ObjectProperty .

fix_orchestra:scenario_id a owl:DatatypeProperty ;
    rdfs:label "scenario_id" ;
    rdfs:range fix_orchestra:Id ;
    skos:altLabel "scenarioId" ;
    skos:definition "Unique identifier of a scenario. Default is '1' for base scenario." ;
    skos:exactMatch fixr:scenarioId ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> .

fix_orchestra:Id a rdfs:Datatype ;
    owl:equivalentClass xsd:integer .

fix_orchestra:DcSimpleLiteral a owl:Class ;
    rdfs:label "DcSimpleLiteral" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:content ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty fix_orchestra:lang ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fix_orchestra:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fix_orchestra:content ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty fix_orchestra:lang ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:lang ] ;
    skos:altLabel "SimpleLiteral" ;
    skos:definition "This is the default type for all of the DC elements. It permits text content only with optional xml:lang attribute. Text is allowed because mixed=\"true\", but sub-elements are disallowed because minOccurs=\"0\" and maxOccurs=\"0\" are on the xs:any tag. This complexType allows for restriction or extension permitting child elements." ;
    skos:exactMatch dc:SimpleLiteral ;
    skos:inScheme fix_orchestra:dc ;
    fix_orchestra:xsd_base "xs:anyType" ;
    fix_orchestra:xsd_source "dc.xsd" .

fix_orchestra:id a owl:DatatypeProperty .

fix_orchestra:DcAny a owl:Class ;
    rdfs:label "DcAny" ;
    rdfs:subClassOf [ owl:unionOf ( fix_orchestra:DcContributor fix_orchestra:DcCoverage fix_orchestra:DcCreator fix_orchestra:DcDate fix_orchestra:DcDescription fix_orchestra:DcFormat fix_orchestra:DcIdentifier fix_orchestra:DcLanguage fix_orchestra:DcPublisher fix_orchestra:DcRelation fix_orchestra:DcRights fix_orchestra:DcSource fix_orchestra:DcSubject fix_orchestra:DcTitle fix_orchestra:DcType fix_orchestra:DctermsAccrualMethod fix_orchestra:DctermsAccrualPeriodicity fix_orchestra:DctermsAccrualPolicy fix_orchestra:DctermsAudience fix_orchestra:DctermsInstructionalMethod fix_orchestra:DctermsProvenance fix_orchestra:DctermsRightsHolder ) ],
        fix_orchestra:DcSimpleLiteral ;
    skos:altLabel "any" ;
    skos:exactMatch dc:any ;
    skos:inScheme fix_orchestra:dc ;
    fix_orchestra:xsd_source "dc.xsd" .

fix_orchestra:value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    rdfs:range xsd:string ;
    skos:definition "Mixed text content of the element." ;
    skos:inScheme fix_orchestra:dc .

fix_orchestra:Annotation a owl:Class ;
    rdfs:label "Annotation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom fix_orchestra:Appinfo ;
            owl:onProperty fix_orchestra:appinfo ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:documentation ],
        [ a owl:Restriction ;
            owl:allValuesFrom fix_orchestra:Documentation ;
            owl:onProperty fix_orchestra:documentation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty fix_orchestra:appinfo ],
        fix_orchestra:EntityAttribGrp ;
    skos:altLabel "annotation" ;
    skos:exactMatch fixr:annotation,
        fix_orchestra:Annotation ;
    skos:inScheme <https://w3id.org/lmodel/fix-orchestra> ;
    fix_orchestra:xsd_source "repositorytypes.xsd" .

fix_orchestra:base a owl:DatatypeProperty .

fix_orchestra:Name a rdfs:Datatype ;
    owl:equivalentClass xsd:string .

fix_orchestra:name a owl:DatatypeProperty .

fix_orchestra:annotation a owl:ObjectProperty .


