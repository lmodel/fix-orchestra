    skos:altLabel "accessRights" ;
    skos:exactMatch dcterms:accessRights ;
    skos:inScheme fix_orchestra:dc ;
    fix_orchestra:xsd_source "dcterms.xsd" .

fix_orchestra:DctermsAlternative a owl:Class ;
    rdfs:label "DctermsAlternative" ;
    rdfs:subClassOf fix_orchestra:DctermsTitle ;
    skos:altLabel "alternative" ;
    skos:exactMatch dcterms:alternative ;
    skos:inScheme fix_orchestra:dc ;
    fix_orchestra:xsd_source "dcterms.xsd" .

fix_orchestra:DctermsAvailable a owl:Class ;
    rdfs:label "DctermsAvailable" ;
