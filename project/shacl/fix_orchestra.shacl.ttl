            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fix_orchestra:id ],
        [ sh:datatype fix_orchestra:Id ;
            sh:defaultValue 1 ;
            sh:description "Unique identifier of a scenario. Default is '1' for base scenario." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fix_orchestra:scenario_id ],
        [ sh:datatype fix_orchestra:Name ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fix_orchestra:name ],
        [ sh:datatype fix_orchestra:Name ;
            sh:defaultValue "base"^^xsd:string ;
            sh:description "The use case of an element, distinguished by workflow, asset class, etc." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fix_orchestra:scenario ],
        [ sh:datatype fix_orchestra:Name ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fix_orchestra:abbr_name ] ;
    sh:targetClass fix_orchestra:OidGrp .

fix_orchestra:RefidGrp a sh:NodeShape ;
    rdfs:comment "A reference to a message element by its key identifiers" ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype fix_orchestra:Id ;
            sh:defaultValue 1 ;
