dc:SimpleLiteral a sh:NodeShape ;
    rdfs:comment "This is the default type for all of the DC elements. It permits text content only with optional xml:lang attribute. Text is allowed because mixed=\"true\", but sub-elements are disallowed because minOccurs=\"0\" and maxOccurs=\"0\" are on the xs:any tag. This complexType allows for restriction or extension permitting child elements." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fix_orchestra:lang ],
        [ sh:datatype xsd:string ;
            sh:description "Pass-through xs:any content as raw strings." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fix_orchestra:content ],
        [ sh:datatype xsd:string ;
            sh:description "Mixed text content of the element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fix_orchestra:value ] ;
    sh:targetClass dc:SimpleLiteral .

