            sh:path fix_orchestra:value ],
        [ sh:datatype fix_orchestra:EP ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fix_orchestra:added_ep ],
        [ sh:datatype xsd:string ;
            sh:description "A hint to processes about how to interpret the element. Not validated." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 30 ;
            sh:path fix_orchestra:rendering ],
        [ sh:datatype fix_orchestra:Version ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path fix_orchestra:last_modified ],
        [ sh:datatype xsd:string ;
            sh:description "Character encoding if other than US-ASCII" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path fix_orchestra:encoding ],
        [ sh:in ( "Editorial" "Definitional" ) ;
            sh:maxCount 1 ;
            sh:order 12 ;
            sh:path fix_orchestra:change_type ],
        [ sh:datatype fix_orchestra:ExpressionType ;
            sh:description "Content of element holds an assignment expression for a message field or state variable" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fix_orchestra:assign ],
        [ sh:datatype fix_orchestra:Id ;
            sh:defaultValue 1 ;
            sh:description "Unique identifier of a scenario. Default is '1' for base scenario." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fix_orchestra:scenario_id ],
        [ sh:datatype fix_orchestra:Name ;
            sh:description "Override the field name for this instance, for code generation and the like. Allows more than one instance of a field in a message or component." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fix_orchestra:instance_name ],
        [ sh:datatype fix_orchestra:Version ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fix_orchestra:added ],
        [ sh:class fix_orchestra:FieldRuleType ;
            sh:description "Rule to tell when a conditionally require field is required or forbidden, to override other attributes, or perform validation." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fix_orchestra:rule ],
        [ sh:datatype fix_orchestra:Name ;
            sh:defaultValue "base"^^xsd:string ;
            sh:description "The use case of an element, distinguished by workflow, asset class, etc." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fix_orchestra:scenario ],
        [ sh:datatype fix_orchestra:Id ;
            sh:description "Identifies a field used as a length prefix" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fix_orchestra:length_id ],
        [ sh:datatype fix_orchestra:Version ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path fix_orchestra:updated ],
        [ sh:datatype fix_orchestra:Name ;
            sh:description "The name is optional as part of a reference and only for convenience. It is not enforced by referential integrity. However, the name of the referred object is authoritative. A validator may check the consistency between the name used for the reference and the name of the referred object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fix_orchestra:name ],
        [ sh:defaultValue "optional" ;
            sh:description "Overrides presence when expression is true" ;
            sh:in ( "optional" "required" "forbidden" "ignored" "constant" ) ;
            sh:maxCount 1 ;
            sh:order 28 ;
            sh:path fix_orchestra:presence ],
        [ sh:datatype fix_orchestra:Version ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path fix_orchestra:replaced ],
        [ sh:datatype fix_orchestra:Id ;
            sh:description "Numeric identifier generally must be unique within a file for an element type, e.g. unique field tag" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fix_orchestra:id ],
        [ sh:datatype xsd:integer ;
            sh:description "Fixed length" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path fix_orchestra:impl_length ],
        [ sh:class fix_orchestra:Annotation ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fix_orchestra:annotation ],
        [ sh:datatype fix_orchestra:EP ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fix_orchestra:deprecated_ep ],
        [ sh:datatype fix_orchestra:EP ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path fix_orchestra:replaced_ep ],
        [ sh:datatype fix_orchestra:EP ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path fix_orchestra:updated_ep ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path fix_orchestra:impl_max_length ],
        [ sh:datatype fix_orchestra:Id ;
            sh:description "Identifies a non-encoded field related to an encoded field" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fix_orchestra:non_encoded_field_id ],
        [ sh:datatype xsd:string ;
            sh:description "Inclusive lower bound" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path fix_orchestra:min_inclusive ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path fix_orchestra:impl_min_length ],
        [ sh:defaultValue "supported" ;
            sh:in ( "supported" "forbidden" "ignored" ) ;
            sh:maxCount 1 ;
            sh:order 19 ;
            sh:path fix_orchestra:supported ],
        [ sh:datatype fix_orchestra:Id ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path fix_orchestra:replaced_by_field ],
        [ sh:datatype xsd:string ;
            sh:description "Inclusive upper bound" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path fix_orchestra:max_inclusive ] ;
    sh:targetClass fix_orchestra:FieldRefType .

fix_orchestra:Annotation a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fix_orchestra:Appinfo ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fix_orchestra:appinfo ],
        [ sh:defaultValue "supported" ;
            sh:in ( "supported" "forbidden" "ignored" ) ;
            sh:maxCount 1 ;
            sh:order 11 ;
            sh:path fix_orchestra:supported ],
        [ sh:datatype fix_orchestra:Version ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path fix_orchestra:deprecated ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fix_orchestra:issue ],
        [ sh:datatype fix_orchestra:Version ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fix_orchestra:updated ],
        [ sh:datatype fix_orchestra:Version ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fix_orchestra:replaced ],
        [ sh:datatype fix_orchestra:Version ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fix_orchestra:added ],
        [ sh:in ( "Editorial" "Definitional" ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path fix_orchestra:change_type ],
        [ sh:class fix_orchestra:Documentation ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fix_orchestra:documentation ],
        [ sh:datatype fix_orchestra:EP ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fix_orchestra:added_ep ],
        [ sh:datatype fix_orchestra:EP ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fix_orchestra:updated_ep ],
        [ sh:datatype fix_orchestra:Version ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fix_orchestra:last_modified ],
        [ sh:datatype fix_orchestra:EP ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fix_orchestra:replaced_ep ],
        [ sh:datatype fix_orchestra:EP ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fix_orchestra:deprecated_ep ],
        [ sh:datatype fix_orchestra:Id ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fix_orchestra:replaced_by_field ] ;
    sh:targetClass fix_orchestra:Annotation .

