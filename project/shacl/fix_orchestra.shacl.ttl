@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fix_orchestra: <https://w3id.org/lmodel/fix-orchestra/> .
@prefix fixi: <http://fixprotocol.io/2024/orchestra/interfaces/> .
@prefix fixr: <http://fixprotocol.io/2024/orchestra/repository/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xml1: <http://www.w3.org/XML/1998/namespace#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fixi:baseInterfaceType a sh:NodeShape ;
    sh:closed false ;
    sh:ignoredProperties ( fixi:sessions fixi:securityKeys fixi:activationTime rdf:type fix_orchestra:identifier fixi:deactivationTime fixi:role ) ;
    sh:property [ sh:class fixi:sessionProtocolType ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fixi:sessionProtocol ],
        [ sh:class fixi:protocolType ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fixi:protocol ],
        [ sh:class fixi:serviceType ;
            sh:description "An application layer protocol with orchestration" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fixi:service ],
        [ sh:datatype xsd:string ;
            sh:description "Pass-through xs:anyAttribute values keyed by their XML attribute name (open extension point)." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fix_orchestra:extra_attributes ],
        [ sh:class fixi:userInterfaceType ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fixi:userInterface ],
        [ sh:class fixi:annotation ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fixi:annotation ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fixi:name ],
        [ sh:class fixi:encodingType ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fixi:encoding ],
        [ sh:class fixi:transportProtocolType ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fixi:transport ] ;
    sh:targetClass fixi:baseInterfaceType .

fixi:interfaces a sh:NodeShape ;
    rdfs:comment "This represents the current state of service and session configurations. Changes to configuration can represented with patch operations. See IETF RFC 5261" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fixi:interfaceType ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fixi:interface ],
        [ sh:class dcterms:elementOrRefinementContainer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fixi:metadata ] ;
    sh:targetClass fixi:interfaces .

fixr:entityAttribGrp a sh:NodeShape ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:defaultValue "supported" ;
            sh:in ( "supported" "forbidden" "ignored" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path fixr:supported ],
        [ sh:datatype fixr:Version_t ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fixr:replaced ],
        [ sh:datatype fixr:EP_t ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fixr:replacedEP ],
        [ sh:datatype fixr:id_t ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fixr:replacedByField ],
        [ sh:in ( "Editorial" "Definitional" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path fixr:changeType ],
        [ sh:datatype fixr:Version_t ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fixr:lastModified ],
        [ sh:datatype fixr:EP_t ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fixr:deprecatedEP ],
        [ sh:datatype fixr:Version_t ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path fixr:updated ],
        [ sh:datatype fixr:EP_t ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fixr:updatedEP ],
        [ sh:datatype fixr:Version_t ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fixr:added ],
        [ sh:datatype fixr:Version_t ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fixr:deprecated ],
        [ sh:datatype fixr:EP_t ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fixr:addedEP ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fixr:issue ] ;
    sh:targetClass fixr:entityAttribGrp .

fixr:fieldAttribGrp a sh:NodeShape ;
    rdfs:comment "Attributes of a field that be overridden by a rule" ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fixr:implMaxLength ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fixr:implMinLength ],
        [ sh:datatype xsd:string ;
            sh:description "If presence is optional, then it represents a default when the sender does not provide the field. If presence is constant, then it is the constant value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fixr:value ],
        [ sh:defaultValue "optional" ;
            sh:description "Overrides presence when expression is true" ;
            sh:in ( "optional" "required" "forbidden" "ignored" "constant" ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path fixr:presence ],
        [ sh:datatype xsd:string ;
            sh:description "Inclusive upper bound" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fixr:maxInclusive ],
        [ sh:datatype xsd:string ;
            sh:description "Character encoding if other than US-ASCII" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fixr:encoding ],
        [ sh:datatype xsd:string ;
            sh:description "A hint to processes about how to interpret the element. Not validated." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fixr:rendering ],
        [ sh:datatype xsd:integer ;
            sh:description "Fixed length" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fixr:implLength ],
        [ sh:datatype xsd:string ;
            sh:description "Inclusive lower bound" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fixr:minInclusive ] ;
    sh:targetClass fixr:fieldAttribGrp .

fixr:oidGrp a sh:NodeShape ;
    rdfs:comment "The identifiers of a message element" ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype fixr:Name_t ;
            sh:defaultValue "base"^^xsd:string ;
            sh:description "The use case of an element, distinguished by workflow, asset class, etc." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fixr:scenario ],
        [ sh:datatype fixr:id_t ;
            sh:description "Numeric identifier generally must be unique within a file for an element type, e.g. unique field tag" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fixr:id ],
        [ sh:datatype fixr:id_t ;
            sh:defaultValue 1 ;
            sh:description "Unique identifier of a scenario. Default is '1' for base scenario." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fixr:scenarioId ],
        [ sh:datatype fixr:Name_t ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fixr:name ],
        [ sh:datatype fixr:Name_t ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fixr:abbrName ] ;
    sh:targetClass fixr:oidGrp .

fixr:refidGrp a sh:NodeShape ;
    rdfs:comment "A reference to a message element by its key identifiers" ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype fixr:Name_t ;
            sh:description "The name is optional as part of a reference and only for convenience. It is not enforced by referential integrity. However, the name of the referred object is authoritative. A validator may check the consistency between the name used for the reference and the name of the referred object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fixr:name ],
        [ sh:datatype fixr:id_t ;
            sh:defaultValue 1 ;
            sh:description "Unique identifier of a scenario. Default is '1' for base scenario." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fixr:scenarioId ],
        [ sh:datatype fixr:Name_t ;
            sh:defaultValue "base"^^xsd:string ;
            sh:description "The use case of an element, distinguished by workflow, asset class, etc." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fixr:scenario ],
        [ sh:datatype fixr:id_t ;
            sh:description "Numeric identifier generally must be unique within a file for an element type, e.g. unique field tag" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fixr:id ] ;
    sh:targetClass fixr:refidGrp .

fixr:repository a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fixr:components ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path fixr:components ],
        [ sh:class fixr:messages ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path fixr:messages ],
        [ sh:class dcterms:elementOrRefinementContainer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fixr:metadata ],
        [ sh:class fixr:sections ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fixr:sections ],
        [ sh:description "An associated namespace as URI" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path fixr:namespace ],
        [ sh:class fixr:categories ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fixr:categories ],
        [ sh:description "Reference documentation" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path fixr:specUrl ],
        [ sh:class fixr:scenarios ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path fixr:scenarios ],
        [ sh:class fixr:actors ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path fixr:actors ],
        [ sh:class fixr:groups ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path fixr:groups ],
        [ sh:class fixr:codeSets ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fixr:codeSets ],
        [ sh:class fixr:fields ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fixr:fields ],
        [ sh:class fixr:annotation ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path fixr:annotation ],
        [ sh:datatype xsd:string ;
            sh:description "Stable name that does not change with minor version updates" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path fixr:name ],
        [ sh:datatype fixr:Version_t ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path fixr:version ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fixr:guid ],
        [ sh:class fixr:datatypes ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fixr:datatypes ],
        [ sh:datatype xsd:string ;
            sh:defaultValue "Score"^^xsd:string ;
            sh:description "The syntax of 'expressionType'" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path fixr:expressionLanguage ],
        [ sh:class fixr:concepts ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path fixr:concepts ] ;
    sh:targetClass fixr:repository .

fixr:scenarioRefGrp a sh:NodeShape ;
    rdfs:comment "A reference to a scenario by its key identifiers. There are no defaults as scenario references are optional." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype fixr:id_t ;
            sh:description "Unique identifier of a scenario. The identifier is required when referencing another scenario." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fixr:scenarioRefId ],
        [ sh:datatype fixr:Name_t ;
            sh:description "Name of a scenario. The name is optional as part of a reference and only for convenience." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fixr:scenarioRef ] ;
    sh:targetClass fixr:scenarioRefGrp .

dc:SimpleLiteral a sh:NodeShape ;
    rdfs:comment "This is the default type for all of the DC elements. It permits text content only with optional xml:lang attribute. Text is allowed because mixed=\"true\", but sub-elements are disallowed because minOccurs=\"0\" and maxOccurs=\"0\" are on the xs:any tag. This complexType allows for restriction or extension permitting child elements." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fix_orchestra:lang ],
        [ sh:datatype xsd:string ;
            sh:description "Mixed text content of the element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fix_orchestra:value ],
        [ sh:datatype xsd:string ;
            sh:description "Pass-through xs:any content as raw strings." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fix_orchestra:content ] ;
    sh:targetClass dc:SimpleLiteral .

dc:any a sh:NodeShape ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Pass-through xs:any content as raw strings." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fix_orchestra:content ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fix_orchestra:lang ],
        [ sh:datatype xsd:string ;
            sh:description "Mixed text content of the element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fix_orchestra:value ] ;
    sh:targetClass dc:any .

dc:contributor a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Pass-through xs:any content as raw strings." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fix_orchestra:content ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fix_orchestra:lang ],
        [ sh:datatype xsd:string ;
            sh:description "Mixed text content of the element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fix_orchestra:value ] ;
    sh:targetClass dc:contributor .

dc:coverage a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Mixed text content of the element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fix_orchestra:value ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fix_orchestra:lang ],
        [ sh:datatype xsd:string ;
            sh:description "Pass-through xs:any content as raw strings." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fix_orchestra:content ] ;
    sh:targetClass dc:coverage .

dc:creator a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Mixed text content of the element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fix_orchestra:value ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fix_orchestra:lang ],
        [ sh:datatype xsd:string ;
            sh:description "Pass-through xs:any content as raw strings." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fix_orchestra:content ] ;
    sh:targetClass dc:creator .

dc:date a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Mixed text content of the element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fix_orchestra:value ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fix_orchestra:lang ],
        [ sh:datatype xsd:string ;
            sh:description "Pass-through xs:any content as raw strings." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fix_orchestra:content ] ;
    sh:targetClass dc:date .

dc:description a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Pass-through xs:any content as raw strings." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fix_orchestra:content ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fix_orchestra:lang ],
        [ sh:datatype xsd:string ;
            sh:description "Mixed text content of the element." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fix_orchestra:value ] ;
    sh:targetClass dc:description .

dc:elementContainer a sh:NodeShape ;
    rdfs:comment "This complexType is included as a convenience for schema authors who need to define a root or container element for all of the DC elements." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Free-text value of the Dublin Core element/refinement `audience`. Expanded from the XSD substitutionGroup chain rooted at dc:any." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 41 ;
            sh:path dcterms:audience ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text value of the Dublin Core element/refinement `format`. Expanded from the XSD substitutionGroup chain rooted at dc:any." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dcterms:format ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text value of the Dublin Core element/refinement `educationLevel`. Expanded from the XSD substitutionGroup chain rooted at dc:any." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 49 ;
            sh:path dcterms:educationLevel ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text value of the Dublin Core element/refinement `references`. Expanded from the XSD substitutionGroup chain rooted at dc:any." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 35 ;
            sh:path dcterms:references ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text value of the Dublin Core element/refinement `type`. Expanded from the XSD substitutionGroup chain rooted at dc:any." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 53 ;
            sh:path dcterms:type ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text value of the Dublin Core element/refinement `coverage`. Expanded from the XSD substitutionGroup chain rooted at dc:any." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path dcterms:coverage ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text value of the Dublin Core element/refinement `isReferencedBy`. Expanded from the XSD substitutionGroup chain rooted at dc:any." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 34 ;
            sh:path dcterms:isReferencedBy ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text value of the Dublin Core element/refinement `dateCopyrighted`. Expanded from the XSD substitutionGroup chain rooted at dc:any." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path dcterms:dateCopyrighted ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text value of the Dublin Core element/refinement `isVersionOf`. Expanded from the XSD substitutionGroup chain rooted at dc:any." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path dcterms:isVersionOf ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text value of the Dublin Core element/refinement `rightsHolder`. Expanded from the XSD substitutionGroup chain rooted at dc:any." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 47 ;
            sh:path dcterms:rightsHolder ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text value of the Dublin Core element/refinement `creator`. Expanded from the XSD substitutionGroup chain rooted at dc:any." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:creator ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text value of the Dublin Core element/refinement `medium`. Expanded from the XSD substitutionGroup chain rooted at dc:any." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path dcterms:medium ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text value of the Dublin Core element/refinement `isPartOf`. Expanded from the XSD substitutionGroup chain rooted at dc:any." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path dcterms:isPartOf ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text value of the Dublin Core element/refinement `replaces`. Expanded from the XSD substitutionGroup chain rooted at dc:any." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 29 ;
            sh:path dcterms:replaces ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text value of the Dublin Core element/refinement `alternative`. Expanded from the XSD substitutionGroup chain rooted at dc:any." ;
            sh:maxCount 1 ;
