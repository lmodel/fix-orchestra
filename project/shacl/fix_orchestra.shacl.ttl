fix_orchestra:FieldAttribGrp a sh:NodeShape ;
    rdfs:comment "Attributes of a field that be overridden by a rule" ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fix_orchestra:impl_min_length ],
        [ sh:datatype xsd:integer ;
            sh:description "Fixed length" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fix_orchestra:impl_length ],
        [ sh:datatype xsd:string ;
            sh:description "Inclusive lower bound" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fix_orchestra:min_inclusive ],
        [ sh:defaultValue "optional" ;
            sh:description "Overrides presence when expression is true" ;
            sh:in ( "optional" "required" "forbidden" "ignored" "constant" ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path fix_orchestra:presence ],
        [ sh:datatype xsd:string ;
            sh:description "Character encoding if other than US-ASCII" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fix_orchestra:encoding ],
        [ sh:datatype xsd:string ;
            sh:description "A hint to processes about how to interpret the element. Not validated." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fix_orchestra:rendering ],
        [ sh:datatype xsd:string ;
            sh:description "Inclusive upper bound" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fix_orchestra:max_inclusive ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fix_orchestra:impl_max_length ],
        [ sh:datatype xsd:string ;
            sh:description "If presence is optional, then it represents a default when the sender does not provide the field. If presence is constant, then it is the constant value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fix_orchestra:value ] ;
    sh:targetClass fix_orchestra:FieldAttribGrp .

fix_orchestra:Interfaces a sh:NodeShape ;
    rdfs:comment "This represents the current state of service and session configurations. Changes to configuration can represented with patch operations. See IETF RFC 5261" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fix_orchestra:InterfaceType ;
            sh:nodeKind sh:BlankNodeOrIRI ;
