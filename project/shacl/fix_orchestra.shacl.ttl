            sh:order 1 ;
            sh:path fix_orchestra:group_ref ],
        [ sh:class fix_orchestra:FieldRefType ;
            sh:description "Other field or fields that scope uniqueness. If none provided, then the field value must be globally unique." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fix_orchestra:field_ref ] ;
    sh:targetClass fix_orchestra:BlockAssignmentType .

fix_orchestra:ComponentRuleType a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype fix_orchestra:Name ;
            sh:description "Name of this rule" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fix_orchestra:name ],
        [ sh:datatype fix_orchestra:ExpressionType ;
            sh:description "A condition that distinguishes when a scenario of a message type applies. It could be used to generate a decision tree to correlate an incoming message to its scenario, or to decide which scenario of a request message to send." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fix_orchestra:when ],
        [ sh:defaultValue "optional" ;
            sh:description "Overrides presence when expression is true" ;
            sh:in ( "optional" "required" "forbidden" "ignored" "constant" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path fix_orchestra:presence ] ;
    sh:targetClass fix_orchestra:ComponentRuleType .

fix_orchestra:FieldRuleType a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Inclusive lower bound" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fix_orchestra:min_inclusive ],
        [ sh:datatype xsd:string ;
            sh:description "Character encoding if other than US-ASCII" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path fix_orchestra:encoding ],
        [ sh:datatype xsd:integer ;
            sh:description "Fixed length" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fix_orchestra:impl_length ],
        [ sh:defaultValue "optional" ;
            sh:description "Overrides presence when expression is true" ;
            sh:in ( "optional" "required" "forbidden" "ignored" "constant" ) ;
            sh:maxCount 1 ;
            sh:order 10 ;
            sh:path fix_orchestra:presence ],
        [ sh:datatype xsd:string ;
            sh:description "Inclusive upper bound" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fix_orchestra:max_inclusive ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fix_orchestra:impl_min_length ],
        [ sh:datatype fix_orchestra:ExpressionType ;
            sh:description "Content of element holds an assignment expression for a message field or state variable. This can be used for field validation." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fix_orchestra:assign ],
        [ sh:datatype xsd:string ;
            sh:description "A hint to processes about how to interpret the element. Not validated." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path fix_orchestra:rendering ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path fix_orchestra:impl_max_length ],
        [ sh:datatype xsd:string ;
            sh:description "If presence is optional, then it represents a default when the sender does not provide the field. If presence is constant, then it is the constant value." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path fix_orchestra:value ],
        [ sh:datatype fix_orchestra:ExpressionType ;
            sh:description "A condition that distinguishes when a scenario of a message type applies. It could be used to generate a decision tree to correlate an incoming message to its scenario, or to decide which scenario of a request message to send." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fix_orchestra:when ],
        [ sh:class fix_orchestra:UniqueInline ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fix_orchestra:unique ],
        [ sh:datatype fix_orchestra:Name ;
            sh:description "Overrides the type of the referenced field." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fix_orchestra:type ],
        [ sh:datatype fix_orchestra:Name ;
            sh:description "Name of this rule" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fix_orchestra:name ] ;
    sh:targetClass fix_orchestra:FieldRuleType .

fix_orchestra:StateType a sh:NodeShape ;
    rdfs:comment "A state of a state machine. If it has no transitions, then it is a final state." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class fix_orchestra:ActionType ;
            sh:description "Operation fired when entering a state and completing when exiting or earlier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path fix_orchestra:activity ],
        [ sh:class fix_orchestra:ActionType ;
            sh:description "Operation fired when entering a state." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path fix_orchestra:onentry ],
        [ sh:datatype fix_orchestra:Name ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path fix_orchestra:name ],
        [ sh:class fix_orchestra:TransitionType ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fix_orchestra:transition ],
        [ sh:class fix_orchestra:ActionType ;
            sh:description "Operation fired when exiting a state." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path fix_orchestra:onexit ],
        [ sh:class fix_orchestra:Annotation ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path fix_orchestra:annotation ] ;
    sh:targetClass fix_orchestra:StateType .

fix_orchestra:TimerSchedule a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "START" "CANCEL" "RESET" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path fix_orchestra:operation ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fix_orchestra:interval ],
        [ sh:class fix_orchestra:ActionType ;
            sh:description "Action to take when a timer expires" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fix_orchestra:activity ],
        [ sh:datatype fix_orchestra:Name ;
            sh:description "Name of the timer" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fix_orchestra:name ],
        [ sh:datatype fix_orchestra:Name ;
            sh:description "Name of the actor that owns the timer" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fix_orchestra:actor ] ;
    sh:targetClass fix_orchestra:TimerSchedule .

fix_orchestra:TriggerType a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
