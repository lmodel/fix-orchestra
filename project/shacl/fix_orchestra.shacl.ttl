            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fix_orchestra:state_machine ],
        [ sh:datatype fix_orchestra:Name ;
            sh:description "Name of the transition to invoke" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fix_orchestra:name ] ;
    sh:targetClass fix_orchestra:TriggerType .

fix_orchestra:EncodingType a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Pass-through xs:anyAttribute values keyed by their XML attribute name (open extension point)." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path fix_orchestra:extra_attributes ],
        [ sh:description "Reliability can be implemented at transport, session, or application layers" ;
            sh:in ( "bestEffort" "idempotent" "recoverable" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path fix_orchestra:reliability ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When this version becomes effective" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path fix_orchestra:activation_time ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path fix_orchestra:version ],
        [ sh:datatype fix_orchestra:ProtocolName ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path fix_orchestra:name ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When this version was deprecated; may be replaced or removed in the future" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path fix_orchestra:deprecated ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When this version is no longer effective" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fix_orchestra:deactivation_time ],
        [ sh:in ( "application" "presentation" "session" "transport" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path fix_orchestra:layer ],
        [ sh:class fix_orchestra:InterfaceAnnotation ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path fix_orchestra:annotation ],
        [ sh:description "URI of Orchestra rules of engagement" ;
