        [ sh:datatype fix_orchestra:Name ;
            sh:defaultValue "base"^^xsd:string ;
            sh:description "The use case of an element, distinguished by workflow, asset class, etc." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path fix_orchestra:scenario ],
        [ sh:datatype fix_orchestra:Name ;
            sh:description "The name is optional as part of a reference and only for convenience. It is not enforced by referential integrity. However, the name of the referred object is authoritative. A validator may check the consistency between the name used for the reference and the name of the referred object." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path fix_orchestra:name ],
        [ sh:datatype fix_orchestra:Id ;
