            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path fix_orchestra:metadata ] ;
    sh:targetClass fix_orchestra:Interfaces .

fix_orchestra:OidGrp a sh:NodeShape ;
    rdfs:comment "The identifiers of a message element" ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype fix_orchestra:Id ;
            sh:description "Numeric identifier generally must be unique within a file for an element type, e.g. unique field tag" ;
