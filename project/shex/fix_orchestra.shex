<BaseInterfaceType>  (
    @<InterfaceType> OR @<SessionType>
)

<BaseInterfaceType_struct> {
    (  $<BaseInterfaceType_tes> (  <service> @<ServiceType> * ;
          <user_interface> @<UserInterfaceType> * ;
          <session_protocol> @<SessionProtocolType> * ;
          <protocol> @<ProtocolType> * ;
          <transport> @<TransportProtocolType> * ;
          <extra_attributes> @linkml:String * ;
          <encoding> @<EncodingType> * ;
          <annotation> @<InterfaceAnnotation> ? ;
          <name> @linkml:String
       ) ;
       rdf:type [ <BaseInterfaceType> ] ?
    )
}

