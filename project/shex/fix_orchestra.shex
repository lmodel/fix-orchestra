          <extra_attributes> @linkml:String * ;
          <lang_id> @<Language> ? ;
          <purpose> @<Purpose> ? ;
          <added> @<Version> ? ;
          <added_ep> @<EP> ? ;
          <change_type> [ <https://w3id.org/lmodel/fix-orchestra/ChangeType#Editorial>
             <https://w3id.org/lmodel/fix-orchestra/ChangeType#Definitional> ] ? ;
