          fixr:timer @<TimerType> * ;
          fixr:group @<GroupType> * ;
          fixr:annotation @<Annotation> ? ;
          fixr:name @<Name>
       ) ;
       rdf:type [ fixr:actorType ] ?
    )
}

<Annotation> CLOSED {
    (  $<Annotation_tes> (  &<EntityAttribGrp_tes> ;
          rdf:type [ fixr:entityAttribGrp ] ? ;
          fixr:documentation @<Documentation> * ;
          fixr:appinfo @<Appinfo> * ;
          fixr:added @<Version> ? ;
          fixr:addedEP @<EP> ? ;
          fixr:changeType [ <https://w3id.org/lmodel/fix-orchestra/ChangeType#Editorial>
             <https://w3id.org/lmodel/fix-orchestra/ChangeType#Definitional> ] ? ;
          fixr:deprecatedEP @<EP> ? ;
          fixr:issue @linkml:String ? ;
          fixr:lastModified @<Version> ? ;
          fixr:replaced @<Version> ? ;
          fixr:replacedEP @<EP> ? ;
          fixr:replacedByField @<Id> ? ;
          fixr:supported [ <https://w3id.org/lmodel/fix-orchestra/SupportType#supported>
             <https://w3id.org/lmodel/fix-orchestra/SupportType#forbidden>
             <https://w3id.org/lmodel/fix-orchestra/SupportType#ignored> ] ? ;
          fixr:updated @<Version> ? ;
          fixr:updatedEP @<EP> ? ;
          fixr:deprecated @<Version> ?
       ) ;
       rdf:type [ fixr:annotation ] ?
    )
}

<Appinfo> CLOSED {
    (  $<Appinfo_tes> (  &<EntityAttribGrp_tes> ;
          rdf:type [ fixr:entityAttribGrp ] ? ;
