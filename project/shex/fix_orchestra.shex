<DcAny>  (
    @<DcContributor> OR @<DcCoverage> OR @<DcCreator> OR @<DcDate> OR @<DcDescription> OR @<DcFormat> OR @<DcIdentifier> OR
    @<DcLanguage> OR @<DcPublisher> OR @<DcRelation> OR @<DcRights> OR @<DcSource> OR @<DcSubject> OR @<DcTitle> OR @<DcType> OR
    @<DctermsAccrualMethod> OR @<DctermsAccrualPeriodicity> OR @<DctermsAccrualPolicy> OR @<DctermsAudience> OR
    @<DctermsInstructionalMethod> OR @<DctermsProvenance> OR @<DctermsRightsHolder>
)

<DcAny_struct> {
    (  $<DcAny_tes> (  &<DcSimpleLiteral_tes> ;
          rdf:type [ dc:SimpleLiteral ] ?
       ) ;
       rdf:type [ dc:any ] ?
    )
}

<DcContributor>  (
    CLOSED {
       (  $<DcContributor_tes> (  &<DcAny_tes> ;
             rdf:type [ dc:any ] ?
          ) ;
          rdf:type [ dc:contributor ] ?
       )
    } OR @<DctermsContributor>
)

<DcCoverage>  (
    CLOSED {
       (  $<DcCoverage_tes> (  &<DcAny_tes> ;
             rdf:type [ dc:any ] ?
          ) ;
          rdf:type [ dc:coverage ] ?
       )
    } OR @<DctermsCoverage>
)

<DcCreator>  (
    CLOSED {
       (  $<DcCreator_tes> (  &<DcAny_tes> ;
             rdf:type [ dc:any ] ?
          ) ;
          rdf:type [ dc:creator ] ?
       )
    } OR @<DctermsCreator>
)

<DcDate>  (
    CLOSED {
       (  $<DcDate_tes> (  &<DcAny_tes> ;
             rdf:type [ dc:any ] ?
          ) ;
          rdf:type [ dc:date ] ?
       )
