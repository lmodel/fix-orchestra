<DcmitypeDCMIType> dcmitype:DCMIType

<XmlLangType> xml1:lang_t

<ActionType>  (
    CLOSED {
       (  $<ActionType_tes> (  <field> @<FieldType> * ;
             <field_ref> @<FieldRefType> * ;
             <component> @<ComponentType> * ;
             <component_ref> @<ComponentRefType> * ;
             <group_ref> @<GroupRefType> * ;
             <message_ref> @<MessageRefType> * ;
             <trigger> @<TriggerType> * ;
             <timer_schedule> @<TimerSchedule> * ;
             <group> @<GroupType> * ;
             <assign> @<ExpressionType> *
          ) ;
          rdf:type [ <ActionType> ] ?
       )
    } OR @<ResponseType>
)

<Actors> CLOSED {
    (  $<Actors_tes> (  <actor> @<ActorType> * ;
          <flow> @<FlowType> * ;
          <annotation> @<Annotation> ? ;
          <base> @linkml:String ?
       ) ;
       rdf:type [ <Actors> ] ?
    )
}

<ActorType> CLOSED {
    (  $<ActorType_tes> (  <field> @<FieldType> * ;
          <field_ref> @<FieldRefType> * ;
          <component> @<ComponentType> * ;
          <component_ref> @<ComponentRefType> * ;
          <group_ref> @<GroupRefType> * ;
          <states> @<StateMachineType> * ;
          <timer> @<TimerType> * ;
          <group> @<GroupType> * ;
          <annotation> @<Annotation> ? ;
          <name> @<Name>
       ) ;
       rdf:type [ <ActorType> ] ?
    )
}

<Annotation> CLOSED {
    (  $<Annotation_tes> (  &<EntityAttribGrp_tes> ;
          rdf:type [ <EntityAttribGrp> ] ? ;
          <documentation> @<Documentation> * ;
          <appinfo> @<Appinfo> * ;
          <added> @<Version> ? ;
          <added_ep> @<EP> ? ;
          <change_type> [ <https://w3id.org/lmodel/fix-orchestra/ChangeType#Editorial>
             <https://w3id.org/lmodel/fix-orchestra/ChangeType#Definitional> ] ? ;
          <deprecated_ep> @<EP> ? ;
          <issue> @linkml:String ? ;
          <last_modified> @<Version> ? ;
          <replaced> @<Version> ? ;
          <replaced_ep> @<EP> ? ;
          <replaced_by_field> @<Id> ? ;
          <supported> [ <https://w3id.org/lmodel/fix-orchestra/SupportType#supported>
             <https://w3id.org/lmodel/fix-orchestra/SupportType#forbidden>
             <https://w3id.org/lmodel/fix-orchestra/SupportType#ignored> ] ? ;
          <updated> @<Version> ? ;
          <updated_ep> @<EP> ? ;
          <deprecated> @<Version> ?
       ) ;
       rdf:type [ <Annotation> ] ?
    )
}

<Appinfo> CLOSED {
    (  $<Appinfo_tes> (  &<EntityAttribGrp_tes> ;
          rdf:type [ <EntityAttribGrp> ] ? ;
