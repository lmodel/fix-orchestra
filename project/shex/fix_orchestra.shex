)

<DcDescription>  (
    CLOSED {
       (  $<DcDescription_tes> (  &<DcAny_tes> ;
             rdf:type [ dc:any ] ?
          ) ;
          rdf:type [ dc:description ] ?
       )
    } OR @<DctermsDescription>
)

<DcElementContainer> CLOSED {
    (  $<DcElementContainer_tes> (  dcterms:title @linkml:String ? ;
          dcterms:creator @linkml:String ? ;
          dcterms:subject @linkml:String ? ;
          dcterms:description @linkml:String ? ;
          dcterms:publisher @linkml:String ? ;
          dcterms:contributor @linkml:String ? ;
          dcterms:date @linkml:String ? ;
          dcterms:format @linkml:String ? ;
          dcterms:source @linkml:String ? ;
          dcterms:language @linkml:String ? ;
          dcterms:relation @linkml:String ? ;
          dcterms:coverage @linkml:String ? ;
